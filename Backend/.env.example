# Copy this file to .env and change the values.

# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./healthhub.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://healthhub:healthhub@localhost:5432/healthhub

# Use a long random string in production (at least 32 characters)
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Public URL used to build image links. Leave empty to use the request host.
PUBLIC_BASE_URL=

# Email. Leave SMTP_HOST empty to print emails in the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@healthhub.local
REQUIRE_EMAIL_CONFIRMATION=false

# Drug interaction model service (see "Machine learning" folder). Empty = interaction checks report "unknown".
ML_SERVICE_URL=

ADMIN_EMAIL=admin@healthhub.local
ADMIN_PASSWORD=Admin@12345
TIMEZONE=Africa/Cairo
